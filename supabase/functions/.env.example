# Copy to supabase/functions/.env to grade with Claude locally, then serve functions with:
#   npx supabase functions serve --env-file supabase/functions/.env
# Without this file the local stack uses the deterministic mock grader.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_GRADING=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=30000
AI_DEADLINE_MS=45000
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_USD=5
AI_RATE_LIMIT_PER_HOUR=60
