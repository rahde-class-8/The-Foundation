# Copy to .env.local and fill in values printed by `npx supabase status`.
# Only VITE_* variables are exposed to the browser. Never put service-role or AI keys here.

# SPA (public by design; protected by RLS)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Edge Functions: set via `supabase/functions/.env` locally or `supabase secrets set` remotely.
# AI_PROVIDER=mock
# AI_MODEL_GRADING=
# AI_MODEL_GENERATION=
# AI_TIMEOUT_MS=20000
# AI_MAX_RETRIES=2
# AI_MONTHLY_BUDGET_USD=5
